# Render production: FLASK_ENV=production
FLASK_ENV=development

SECRET_KEY=promptarena-flask-secret-9xK2vL7mQ4pT8sR1aD5
JWT_SECRET_KEY=promptarena-jwt-secret-3nF8qW2xM7zK5pL9tY6

DATABASE_URL=sqlite:///promptarena.db

JWT_ACCESS_TOKEN_EXPIRES=86400
JWT_REFRESH_TOKEN_EXPIRES=604800

CORS_ORIGINS=http://localhost:3000

# Optional: session store + spectator counts. Local dev still processes generation in-process.
# REDIS_URL=redis://localhost:6379/0

# Use Redis/RQ for generation jobs (requires worker_process.py or docker-compose worker).
# Default in development: jobs run in-process even when REDIS_URL is set.
# USE_RQ_QUEUE=1
# RQ_QUEUE_NAME=arena
# Battle generation uses Groq when GROQ_API_KEY is set (restart server after changes).
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant

# Legacy (unused when GROQ_API_KEY is set):
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
PROMPT_DEADLINE_SECONDS=300


SOCKETIO_MESSAGE_QUEUE=
# Local dev (run.py): threading. Render production: eventlet (see gunicorn.conf.py).
SOCKETIO_ASYNC_MODE=threading

MOCK_AI_MIN_LATENCY=2.0
MOCK_AI_MAX_LATENCY=6.0
MOCK_AI_FAILURE_RATE=0.12
GENERATION_JOB_TIMEOUT_SECONDS=120